<Window
    x:Class="SoundShell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SoundShell.App"
    Title="SoundShell">
    <Grid Padding="24" RowSpacing="16" DataContext="{x:Bind ViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE767;" FontSize="28" />
            <TextBlock Text="SoundShell" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ScrollViewer>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:MixerGroupViewModel">
                            <Border Padding="16" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Slider Grid.Column="2" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Volume, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind VolumeText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <CheckBox Grid.Column="4" Content="Mute" IsChecked="{x:Bind MuteState, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE767;" FontSize="40" />
                <TextBlock Text="No active audio sessions." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" IsOpen="True" Severity="Error" Title="SoundShell couldn't access Windows audio" Message="{Binding ErrorMessage}" />
        </Grid>
    </Grid>
</Window>
