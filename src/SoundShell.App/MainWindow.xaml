<Window
    x:Class="SoundShell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SoundShell">
    <Grid Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE767;" FontSize="40" />
            <TextBlock Text="SoundShell" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="No active audio sessions." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
